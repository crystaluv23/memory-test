{
  "schema_version": "collaboration-observed-v0",
  "hypothesis": "Fresh message-only role subagents can drive actual causal tasks and typed research branches without an external API; correctness and qualification precede mechanism selection",
  "transport": "controller_collaboration_tools_with_local_role_ipc",
  "fork_turns": "none",
  "direct_actor_tools": "one_controller_client_only_instruction_not_os_qualified",
  "workspace_policy": "persistent_temporary_root_outside_controller_and_project_denials",
  "workspace_root_mode": 448,
  "actor_roles": [
    "solver",
    "extractor",
    "consolidation",
    "reflector",
    "evaluator",
    "proposer"
  ],
  "agent_slots_max": 96,
  "actor_turns_max": 12,
  "actor_wall_seconds": 600,
  "packet_bytes_max": 90000,
  "response_bytes_max": 90000,
  "engine_bytes_max": 60000,
  "iterations_max": 2,
  "seed": 801,
  "learning_mode": "independent_learning",
  "provider_tokens": null,
  "provider_cost": null,
  "formal_admission": false,
  "automatic_retry": false,
  "selection": "independent_outcomes_required_no_promotion_from_structural_acceptance",
  "message_delivery_policy": "reserved_exact_ipc_reply_authenticated_stdout_ack_no_unknown_retry",
  "termination_policy": "actual_interrupt_receipt_halt_run_preserve_missing_denominator",
  "public_service_grammar": "exact_json_examples_finish_result_native_final_v1",
  "observable_service_sources": "all_acknowledged_public_requests_and_actual_replies_v1",
  "initial_packet_delivery": "authenticated_own_packet_service_v1",
  "bootstrap_invocation": "frozen_complete_exec_command_quoted_heredoc_v1",
  "empty_client_input": "reject_before_state_and_network_v1",
  "actor_start_policy": "native_ready_actual_bind_reserved_go_actual_empty_return_ack_v1",
  "memory_usage_policy": "actual_disclosure_claimed_use_separate_no_inferred_behavior_link_v1"
}
