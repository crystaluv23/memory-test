{
  "schema_version": "epoch-contract-v0",
  "mode": "scripted_acceptance",
  "status": "implementation_not_frozen",
  "hypothesis": "Frozen single-look comparison plans, complete reserved units and an epoch family covering primary and shadow quality claims prevent false progress from adaptive confirmation, repeated evidence or direction multiplicity",
  "active_max": 8,
  "elite_max": 3,
  "proposals_max": 3,
  "confirmation_min": 7,
  "confirmation_max": 14,
  "oracle_min": 0.9,
  "frontier_min": 0.2,
  "frontier_max_exclusive": 0.8,
  "mastery_min": 0.8,
  "mastery_rounds": 2,
  "plateau_attempts": 3,
  "plateau_min_gain": 0.1,
  "success_gain_min": 0.1,
  "noninferiority_margin": 0.1,
  "cost_reduction_min": 0.2,
  "alpha": 0.05,
  "multiple_comparison": "bonferroni_predeclared_comparisons_and_claims",
  "severe_regression_tolerance": 0,
  "decision_claims": [
    "better",
    "worse",
    "noninferior"
  ],
  "shadow_comparisons_max": 3,
  "confirmation_comparisons_max": 9,
  "error_scope": "one_memory_epoch_primary_and_shadow_all_reported_quality_claims",
  "confirmation_policy": "frozen_plan_exact_units_single_look",
  "cost_claim_scope": "observed_frozen_paired_cohort_total_cost_not_future_expected_cost"
}
