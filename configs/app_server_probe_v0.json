  "temporary_authentication": "none_only_harmless_markers",
  "server_execution": "trusted_temporary_controller_not_nested_native_sandbox",
  "authentication_store": "isolated_empty_file_store_no_keychain",
  "inference_policy": "no_thread_turn_login_account_or_provider_rpc",
  "tool_permissions": "explicit_profile_root_deny_minimal_runtime_read_workspace_write_private_deny_network_off",
  "legacy_sandbox_settings": "forbidden",
  "formal_admission": false,
  "authentication_qualified": false,
  "provider_budget_qualified": false,
  "model_calls": 0
}
